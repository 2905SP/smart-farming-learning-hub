
pipeline {
    agent any

    options {
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Source code checked out from GitHub.'
            }
        }

        stage('Validate Website Files') {
            steps {
                bat '''
                    if not exist ise2-smart-farming-hub\\index.html (
                        echo ERROR: index.html missing
                        exit /b 1
                    )
                    if not exist ise2-smart-farming-hub\\style.css (
                        echo ERROR: style.css missing
                        exit /b 1
                    )
                    if not exist ise2-smart-farming-hub\\script.js (
                        echo ERROR: script.js missing
                        exit /b 1
                    )
                    echo Website files found successfully.
                '''
            }
        }

        stage('Check Required Project Files') {
            steps {
                bat '''
                    if not exist ise2-smart-farming-hub\\README.md (
                        echo ERROR: README.md missing
                        exit /b 1
                    )
                    if not exist ise2-smart-farming-hub\\Jenkinsfile (
                        echo ERROR: Jenkinsfile missing
                        exit /b 1
                    )
                    echo All required project files are present.
                '''
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: All required website files were verified.'
        }
        failure {
            echo 'FAILED: Check the Console Output for errors.'
        }
    }
}
